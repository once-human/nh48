{"personas":{"kaka":["mr","man"],"ajoba":["mr","man"],"dada":["mr","man"],"collegeboy":["mr","man"],"kaku":["mr","woman"],"aaji":["mr","woman"],"tai":["mr","woman"],"collegegirl":["mr","woman"],"bhaiya":["hi","man"],"aunty":["hi","woman"],"kpguy":["en","man"],"kpgirl":["en","woman"]},"st":{"nearmiss":{"mr":[["Are! Disat nahi ka?","Hey! Can’t you see?"],["Maarshil ka aata? Halu chalav!","Going to kill me now? Drive slowly!"],["Dole aahet ki nahi?","Do you have eyes or not?"],["Kay re, rasta tujhya baapacha aahe ka?","What, does your father own the road?"],["Thamb re jara! Maansa chaaltaat ithe!","Stop a bit! People walk here!"]],"hi":[["Arre! Dikhta nahi kya?","Hey! Can’t you see?"],["Maarega kya? Dheere chala!","Going to kill someone? Drive slowly!"],["Aankhen hain ki nahi?","Got eyes or not?"],["Sadak tere baap ki hai kya?","Does your father own the road?"],["Ruk ja bhai! Log chal rahe hain!","Stop, man! People are walking!"]],"en":[["Whoa! Watch it!","Whoa! Watch it!"],["Are you trying to kill someone?","Are you trying to kill someone?"],["Seriously? Eyes on the road!","Seriously? Eyes on the road!"],["You nearly hit me!","You nearly hit me!"],["Slow down, man! People walk here!","Slow down! People walk here!"]]},"honked":{"mr":[["Ho ho, jaatoy!","Yes, yes, I’m going!"],["Horn vajavun kay udun jau ka?","Should I fly away because you honked?"],["Evdhi kay ghai aahe?","What’s the big hurry?"],["Bas jhala horn!","Enough with the horn!"],["Distay mala, aandhla nahiye.","I can see, I’m not blind."]],"hi":[["Haan haan, ja raha hoon!","Yes, yes, I’m going!"],["Itna horn kyun baja raha hai?","Why so much honking?"],["Kahan bhaagna hai itni jaldi?","Where’s the rush?"],["Bas kar bhai, horn!","Enough with the horn, man!"],["Dikh raha hai, andha nahi hoon.","I can see, I’m not blind."]],"en":[["Okay, okay, I’m moving!","Okay, okay, I’m moving!"],["Stop honking!","Stop honking!"],["What’s the rush?","What’s the rush?"],["Yes, I heard you.","Yes, I heard you."],["Honking won’t make me fly.","Honking won’t make me fly."]]},"bumped":{"mr":[["Dhakka ka maarlas?","Why did you shove me?"],["Baghun chaal na!","Watch where you walk!"],["Kay re, angavar yetos?","What, you coming at me?"],["Sorry tari mhan!","At least say sorry!"],["Hi kay paddhat aahe?","What kind of manners is this?"]],"hi":[["Dhakka kyun maara?","Why did you push me?"],["Dekh ke chal na!","Watch where you’re going!"],["Upar chadhega kya?","Going to climb on me?"],["Sorry to bol!","At least say sorry!"],["Ye kya tareeka hai?","What kind of manners is this?"]],"en":[["Hey! Watch it!","Hey! Watch it!"],["Did you just shove me?","Did you just shove me?"],["Excuse you!","Excuse you!"],["At least say sorry.","At least say sorry."],["What is your problem?","What is your problem?"]]},"knocked":{"mr":[["Aai ga!","Oh mother!"],["Are deva, maajha paay!","Oh god, my leg!"],["Uthava re mala konitari!","Someone help me up!"],["Paadlas na mala!","You knocked me down!"],["Halu… halu…","Slowly… slowly…"]],"hi":[["Haay maa!","Oh mother!"],["Mera pair!","My leg!"],["Koi uthao mujhe!","Someone lift me up!"],["Gira diya na!","You knocked me down!"],["Aaram se… aaram se…","Easy… easy…"]],"en":[["Ow! Ow!","Ow! Ow!"],["My leg!","My leg!"],["Somebody help me up.","Somebody help me up."],["You knocked me over!","You knocked me over!"],["Easy… easy…","Easy… easy…"]]},"crash":{"mr":[["Are baapre! Dhadakli!","Oh my god! It crashed!"],["Baghitla ka? Poorna thokli!","Did you see? Rammed it completely!"],["Konala laagla tar nahi na?","I hope nobody’s hurt?"],["He asach honaar hota.","This was bound to happen."],["Accident! Thamba thamba!","Accident! Stop, stop!"]],"hi":[["Arre baap re! Thok di!","Oh my god! Rammed it!"],["Dekha? Poora thok diya!","See that? Hit it full on!"],["Kisi ko lagi to nahi?","Is anyone hurt?"],["Yahi hona tha.","This was bound to happen."],["Accident! Ruko ruko!","Accident! Stop, stop!"]],"en":[["Oh my god, they crashed!","Oh my god, they crashed!"],["Did you see that?","Did you see that?"],["Is anyone hurt?","Is anyone hurt?"],["That was coming.","That was coming."],["Accident! Stop!","Accident! Stop!"]]},"hurt":{"mr":[["Ambulance bolva re konitari!","Someone call an ambulance!"],["Shvaas chaalu aahe ka bagha!","Check if they’re breathing!"],["Halvu naka tyanna!","Don’t move them!"],["Paani aana, paani!","Bring water, water!"],["Baajula vha, jaaga dya!","Move aside, give them room!"]],"hi":[["Koi ambulance bulao!","Someone call an ambulance!"],["Saans chal rahi hai kya dekho!","See if they’re breathing!"],["Hilao mat inko!","Don’t move them!"],["Paani lao, paani!","Bring water, water!"],["Hato, jagah do!","Move, give them room!"]],"en":[["Someone call an ambulance!","Someone call an ambulance!"],["Check if they’re breathing!","Check if they’re breathing!"],["Don’t move them!","Don’t move them!"],["Get some water!","Get some water!"],["Give them some room!","Give them some room!"]]},"thief":{"mr":[["Chor! Chor! Pakda tyala!","Thief! Thief! Catch him!"],["Maajha paakit! Maajha paakit gela!","My wallet! My wallet’s gone!"],["Are palaala to, pakda!","He ran, catch him!"],["Polisanna bolva!","Call the police!"],["Maajhi purse! Konitari thaambva!","My purse! Someone stop him!"]],"hi":[["Chor! Chor! Pakdo!","Thief! Thief! Catch him!"],["Mera batua! Batua gaya!","My wallet! It’s gone!"],["Bhaaga vo, pakdo use!","He ran, catch him!"],["Police ko bulao!","Call the police!"],["Mera purse! Koi roko!","My purse! Someone stop him!"]],"en":[["Thief! Stop him!","Thief! Stop him!"],["My wallet! It’s gone!","My wallet! It’s gone!"],["He’s running, grab him!","He’s running, grab him!"],["Somebody call the police!","Somebody call the police!"],["My bag! Stop him!","My bag! Stop him!"]]},"calling":{"mr":[["Hello, police? Ithe gondhal jhalay.","Hello, police? There’s trouble here."],["Ho, mi baghitla, to aattach palaala.","Yes, I saw it, he just ran."],["Gaadicha number lihun ghetlay mi.","I’ve noted down the vehicle number."],["Lavkar ya, ekala laaglay.","Come quickly, someone’s hurt."],["Ho, ithech aahe ajun, lavkar paathva.","Yes, still here, send someone quick."]],"hi":[["Hello, police? Yahan gadbad hui hai.","Hello, police? There’s trouble here."],["Haan, maine dekha, abhi bhaaga.","Yes, I saw it, he just ran."],["Gaadi ka number note kar liya hai.","I’ve noted the vehicle number."],["Jaldi aaiye, kisi ko lagi hai.","Come quickly, someone’s hurt."],["Haan, yahin hai abhi, jaldi bhejiye.","Yes, still here, send someone fast."]],"en":[["Hello, police? Something’s happened here.","Hello, police? Something’s happened here."],["Yes, I saw it, he just ran.","Yes, I saw it, he just ran."],["I’ve got the number plate.","I’ve got the number plate."],["Please hurry, someone’s hurt.","Please hurry, someone’s hurt."],["They’re still here, send someone.","They’re still here, send someone."]]},"hangup":{"mr":[["Nahi nahi, kahi nahi, thevto phone.","No no, nothing, I’m putting the phone down."],["Mi kahi baghitla nahi.","I didn’t see anything."],["Jaato mi, jaato.","I’m going, I’m going."],["Maajha kahi sambandh nahi.","It’s nothing to do with me."],["Theek aahe, theek aahe, shaant.","Okay, okay, calm down."]],"hi":[["Nahi nahi, kuch nahi, rakh raha hoon.","No no, nothing, I’m hanging up."],["Maine kuch nahi dekha.","I didn’t see anything."],["Ja raha hoon, ja raha hoon.","I’m going, I’m going."],["Mera koi lena dena nahi.","It’s nothing to do with me."],["Theek hai, theek hai, shaant.","Okay, okay, calm down."]],"en":[["No, nothing, I’m hanging up.","No, nothing, I’m hanging up."],["I didn’t see anything.","I didn’t see anything."],["I’m going, okay? I’m going.","I’m going, okay? I’m going."],["Not my business.","Not my business."],["Okay, okay, relax.","Okay, okay, relax."]]},"copcame":{"mr":[["Aale bagha police.","Look, the police are here."],["Saheb, tyaane kela, to!","Sir, he did it, him!"],["Bara jhala aalat.","Good thing you came."],["Tikde gela to, tikde!","He went that way, that way!"],["Aata kalel tyala.","Now he’ll learn."]],"hi":[["Aa gayi police.","The police are here."],["Saahab, isne kiya, isne!","Sir, he did it, him!"],["Achha hua aap aa gaye.","Good thing you came."],["Udhar gaya vo, udhar!","He went that way!"],["Ab pata chalega isko.","Now he’ll learn."]],"en":[["Finally, the police.","Finally, the police."],["Officer, it was him!","Officer, it was him!"],["Thank god you’re here.","Thank god you’re here."],["He went that way!","He went that way!"],["Now he’s in trouble.","Now he’s in trouble."]]},"siren":{"mr":[["Baajula vha, ambulance!","Move aside, ambulance!"],["Rasta dya re!","Give way!"],["Gaadya baajula ghya!","Pull the vehicles aside!"],["Konalatari gheun chaallet.","They’re taking someone."],["Dev karo, vaachu de.","God willing, they make it."]],"hi":[["Hato, ambulance!","Move, ambulance!"],["Raasta do bhai!","Give way, man!"],["Gaadiyan side karo!","Pull the vehicles aside!"],["Kisi ko le ja rahe hain.","They’re taking someone."],["Bhagwan kare bach jaaye.","God willing, they make it."]],"en":[["Move aside, ambulance!","Move aside, ambulance!"],["Make way!","Make way!"],["Pull over, pull over!","Pull over, pull over!"],["They’re rushing someone in.","They’re rushing someone in."],["I hope they make it.","I hope they make it."]]},"fire":{"mr":[["Aag! Aag laagli!","Fire! It’s on fire!"],["Laamb vha, phutel ti!","Get back, it’ll blow!"],["Koni aat aahe ka?","Is anyone inside?"],["Fire brigade-la phone kara!","Call the fire brigade!"],["Dhoor bagha, kiti dhoor!","Look at the smoke, so much smoke!"]],"hi":[["Aag! Aag lag gayi!","Fire! It’s on fire!"],["Door hato, phategi!","Get back, it’ll blow!"],["Koi andar hai kya?","Is anyone inside?"],["Fire brigade bulao!","Call the fire brigade!"],["Dekho kitna dhuaan!","Look how much smoke!"]],"en":[["Fire! It’s on fire!","Fire! It’s on fire!"],["Get back, it’s going to blow!","Get back, it’s going to blow!"],["Is anyone inside?","Is anyone inside?"],["Call the fire brigade!","Call the fire brigade!"],["Look at that smoke!","Look at that smoke!"]]},"greet":{"mr":[["Namaskar!","Hello!"],["Kay, kasa kay?","So, how’s it going?"],["Barech divsaanni!","It’s been a while!"],["Jevan jhala ka?","Had your meal?"],["Chala, bhetu nantar.","Okay, see you later."]],"hi":[["Namaste!","Hello!"],["Kya haal hai?","How are you?"],["Bahut din baad!","It’s been a while!"],["Khaana khaaya?","Have you eaten?"],["Chalo, phir milte hain.","Okay, see you later."]],"en":[["Hey, hi!","Hey, hi!"],["How’s it going?","How’s it going?"],["Long time!","Long time!"],["Had lunch?","Had lunch?"],["See you around.","See you around."]]},"chat":{"mr":[["Kaal paaus kiti padla na.","It rained so much yesterday."],["Bhaaji phaar mahaag jhaaliye halli.","Vegetables have got so expensive lately."],["Metro kadhi suru honaar konaas thaauk.","Who knows when the metro will start."],["Aamchya veli Puna shaant hota.","Pune was quiet in our day."],["Chaha gheuya ka ek?","Shall we have a chai?"]],"hi":[["Kal bahut baarish hui na.","It rained a lot yesterday."],["Sabzi bahut mehngi ho gayi.","Vegetables have got so expensive."],["Metro kab chalegi pata nahi.","No idea when the metro will run."],["Traffic bahut badh gaya hai.","Traffic has got so much worse."],["Chai piyen ek?","Shall we have a chai?"]],"en":[["It poured yesterday, right?","It poured yesterday, right?"],["Rent here is crazy now.","Rent here is crazy now."],["When’s the metro finally running?","When’s the metro finally running?"],["This traffic is getting worse.","This traffic is getting worse."],["Coffee?","Coffee?"]]},"mutter":{"mr":[["Kay chaallay ya shaharacha.","What’s happening to this city."],["Sagle ghaait.","Everyone in a hurry."],["Raste bagha, khaddech khadde.","Look at the roads, potholes everywhere."],["Aajkaalchi pora…","Kids these days…"],["Jaau de, aaplyala kay.","Let it go, not my business."]],"hi":[["Kya ho raha hai is shehar ko.","What’s happening to this city."],["Sabko jaldi hai.","Everyone’s in a hurry."],["Sadkein dekho, gaddhe hi gaddhe.","Look at the roads, potholes everywhere."],["Aajkal ke bachche…","Kids these days…"],["Chhodo, apne ko kya.","Let it go, not my business."]],"en":[["What is happening to this city.","What is happening to this city."],["Everyone’s in such a hurry.","Everyone’s in such a hurry."],["These roads, honestly.","These roads, honestly."],["Kids these days…","Kids these days…"],["Whatever. Not my problem.","Whatever. Not my problem."]]},"jam":{"mr":[["He traffic kadhi sutnaar?","When will this traffic clear?"],["Ardha taas ithech adaklo.","Stuck right here for half an hour."],["Pudhe kay jhalay konaas thaauk.","Who knows what happened up ahead."],["Signal pan band aahe vaatta.","Even the signal seems to be off."],["Chaalat gelo asto tar pochlo asto.","Would’ve been there by now on foot."]],"hi":[["Ye traffic kab khulega?","When will this traffic clear?"],["Aadhe ghante se yahin phanse hain.","Stuck here half an hour."],["Aage pata nahi kya hua hai.","Who knows what happened ahead."],["Signal bhi band hai lagta hai.","Signal seems to be off too."],["Paidal jaate to pahunch jaate.","Would’ve been there on foot."]],"en":[["When will this jam clear?","When will this jam clear?"],["Stuck here for half an hour.","Stuck here for half an hour."],["What’s going on up ahead?","What’s going on up ahead?"],["Is the signal even working?","Is the signal even working?"],["Should’ve just walked.","Should’ve just walked."]]},"respect":{"mr":[["Tumhich na te? Changla kelat.","You’re the one, right? Good on you."],["Aamchya gallit tumcha naav aahe.","Our lane knows your name."],["Dev bhala karo.","God bless you."],["Ase lok kami aahet.","There aren’t many like you."],["Ya kadhihi chahaala.","Come for chai any time."]],"hi":[["Aap hi ho na? Achha kiya.","You’re the one, right? Well done."],["Mohalle mein aapka naam hai.","The neighbourhood knows your name."],["Bhagwan bhala kare.","God bless you."],["Aise log kam hain.","There aren’t many like you."],["Kabhi bhi chai pe aao.","Come for chai any time."]],"en":[["Hey, you’re the one who helped, right?","Hey, you’re the one who helped, right?"],["People here talk about you.","People here talk about you."],["Respect.","Respect."],["Not many like you.","Not many like you."],["Coffee’s on me sometime.","Coffee’s on me sometime."]]},"fearyou":{"mr":[["Toch aahe to. Laamb raaha.","That’s the one. Stay away."],["Kaal tyaanech maarla na?","Wasn’t it him who hit someone yesterday?"],["Baghu nakos tyachyakade.","Don’t look at him."],["Chal ithun, chal.","Let’s go from here, come on."],["Polisanna kalvaayla hava.","Someone should tell the police."]],"hi":[["Vahi hai vo. Door raho.","That’s the one. Stay away."],["Kal isi ne maara tha na?","Wasn’t it him yesterday?"],["Uski taraf mat dekho.","Don’t look at him."],["Chalo yahan se.","Let’s get out of here."],["Police ko bataana chahiye.","Someone should tell the police."]],"en":[["That’s the guy. Stay away.","That’s the guy. Stay away."],["Wasn’t he the one from yesterday?","Wasn’t he the one from yesterday?"],["Don’t look at him.","Don’t look at him."],["Let’s go, now.","Let’s go, now."],["Someone should call the cops.","Someone should call the cops."]]},"flee":{"mr":[["Pala! Pala!","Run! Run!"],["Vaachva!","Help!"],["Nako nako, soda!","No, no, let me go!"],["Are deva!","Oh god!"],["Tikde jaau naka!","Don’t go that way!"]],"hi":[["Bhaago! Bhaago!","Run! Run!"],["Bachao!","Help!"],["Nahi nahi, chhodo!","No, no, let go!"],["He bhagwan!","Oh god!"],["Udhar mat jaao!","Don’t go that way!"]],"en":[["Run! Run!","Run! Run!"],["Help!","Help!"],["No, let go of me!","No, let go of me!"],["Oh my god!","Oh my god!"],["Don’t go that way!","Don’t go that way!"]]},"taunt":{"mr":[["Ye, ye na pudhe!","Come on, come closer!"],["Daakhvu ka tula?","Want me to show you?"],["Khoop hava aahe vaatta.","Full of yourself, aren’t you."],["Aata bagh kay hota.","Now watch what happens."],["Gapchup nigh ithun.","Leave quietly."]],"hi":[["Aa, aage aa!","Come on, step up!"],["Dikhaun kya tujhe?","Want me to show you?"],["Bahut hawa hai teri.","Full of yourself, aren’t you."],["Ab dekh kya hota hai.","Now see what happens."],["Chupchaap nikal.","Get lost, quietly."]],"en":[["Come on then!","Come on then!"],["You want some?","You want some?"],["Think you’re tough?","Think you’re tough?"],["Now you’ll see.","Now you’ll see."],["Walk away. Now.","Walk away. Now."]]}},"stctx":{"nearmiss":true,"honked":true,"bumped":true,"knocked":false,"crash":true,"hurt":false,"thief":false,"calling":true,"hangup":false,"copcame":false,"siren":false,"fire":false,"greet":true,"chat":true,"mutter":true,"jam":true,"respect":false,"fearyou":false,"flee":false,"taunt":true},"sttakes":{"nearmiss":2,"honked":1,"bumped":2,"knocked":1,"crash":1,"hurt":1,"thief":1,"calling":1,"hangup":1,"copcame":1,"siren":1,"fire":1,"greet":1,"chat":1,"mutter":1,"jam":1,"respect":1,"fearyou":1,"flee":1,"taunt":2},"ctx":{"base":null,"rain":{"mr":["Tyaat ha paaus!","And this rain on top!"],"hi":["Upar se ye baarish!","And this rain on top!"],"en":["And in this rain!","And in this rain!"]},"heat":{"mr":["Ya unhaat!","In this heat!"],"hi":["Is dhoop mein!","In this heat!"],"en":["In this heat, too.","In this heat, too."]},"night":{"mr":["Evdhya raatri!","At this hour of the night!"],"hi":["Itni raat ko!","At this hour of the night!"],"en":["At this hour!","At this hour!"]},"fest":{"mr":["Sanache divas aahet!","It’s festival time!"],"hi":["Tyohaar ka time hai!","It’s festival time!"],"en":["During the festival, of all times!","During the festival, of all times!"]}},"roles":{"traffic":"mr","beat":"mr","patrol":"hi","qrt":"hi"},"po":{"wave":{"mr":[["O! Ikde ya! Side-la ghya.","Hey! Over here! Pull to the side."],["Thamba! Gaadi baajula ghya.","Stop! Pull the vehicle aside."],["Tumhi, ho tumhich! Thamba.","You, yes you! Stop."]],"hi":[["Ae! Idhar aa! Side mein le.","Hey! Over here! Pull aside."],["Ruko! Gaadi side karo.","Stop! Pull the vehicle aside."],["Tum, haan tum! Ruko.","You, yes you! Stop."]]},"docs":{"mr":[["Licence aani kaagadpatra daakhva.","Show me your licence and papers."],["RC kuthey? Insurance?","Where’s the RC? Insurance?"],["Helmet kuthey tumcha?","Where’s your helmet?"]],"hi":[["License aur kaagaz dikhao.","Show your licence and papers."],["RC kahan hai? Insurance?","Where’s the RC? Insurance?"],["Helmet kahan hai?","Where’s your helmet?"]]},"fine":{"mr":[["Signal todlat. Paachshe rupaye.","You jumped the signal. Five hundred rupees."],["Dand bhara, paavti milel.","Pay the fine, you’ll get a receipt."],["Online bhara kinva ithe, tumchi marji.","Pay online or here, your choice."]],"hi":[["Signal toda. Paanch sau rupaye.","You jumped the signal. Five hundred."],["Jurmaana bharo, raseed milegi.","Pay the fine, you’ll get a receipt."],["Online ya yahin, jaisa chaaho.","Online or here, as you like."]]},"pleadno":{"mr":[["Sagle hech mhantaat.","Everyone says that."],["Pahili vel? Mag shikaal aata.","First time? Then you’ll learn now."],["Radun kahi honaar nahi.","Crying won’t help."]],"hi":[["Sab yahi bolte hain.","Everyone says that."],["Pehli baar? To ab seekhoge.","First time? Then you’ll learn."],["Rone se kuch nahi hoga.","Crying won’t help."]]},"pleadok":{"mr":[["Bara, ja. Punha disalat tar nahi.","Fine, go. Not if I see you again."],["Yaaveli sodto. Lakshaat theva.","Letting you off this time. Remember it."],["Chala, nigha.","Go on, off you go."]],"hi":[["Theek hai, jaao. Dobaara nahi.","Fine, go. Not again."],["Is baar chhod raha hoon. Yaad rakhna.","Letting you off this time. Remember."],["Chalo, niklo.","Go on, get going."]]},"bribehint":{"mr":[["Bola, kay karaycha?","So, what shall we do?"],["Chaha-paanyacha bagha mag.","See about the tea money, then."],["Paavti havi ki nako?","Want a receipt or not?"]],"hi":[["Bolo, kya karna hai?","So, what do we do?"],["Chai-paani ka dekh lo.","Sort out the tea money."],["Raseed chahiye ya nahi?","Want a receipt or not?"]]},"bribeok":{"mr":[["Theek aahe. Nigha patkan.","Fine. Leave quickly."],["Konala saangaycha nahi.","Don’t tell anyone."],["Punha bhetu naka.","Don’t let me see you again."]],"hi":[["Theek hai. Jaldi niklo.","Fine. Leave quickly."],["Kisi ko bolna nahi.","Don’t tell anyone."],["Dobaara mat milna.","Don’t run into me again."]]},"bribeno":{"mr":[["Laach detoy mala? Aat taakin!","Bribing me? I’ll lock you up!"],["He kay? Gunha aahe ha!","What’s this? That’s a crime!"],["Paise parat theva. Aata case lihito.","Put the money away. Now I write a case."]],"hi":[["Rishvat de raha hai? Andar kar doonga!","Bribing me? I’ll lock you up!"],["Ye kya hai? Jurm hai ye!","What’s this? It’s a crime!"],["Paise rakho. Ab case banega.","Keep your money. Now there’s a case."]]},"counter":{"mr":[["Evdhyaane nahi chaalnaar.","That won’t do."],["Thoda vaadhva.","Raise it a little."],["Ajun taaka, mag baghu.","Add some more, then we’ll see."]],"hi":[["Itne se nahi chalega.","That won’t do."],["Thoda badhao.","Raise it a bit."],["Aur daalo, phir dekhte hain.","Add more, then we’ll see."]]},"chase":{"mr":[["Thamb! Palu nakos!","Stop! Don’t run!"],["Pakda re tyala!","Grab him!"],["Jaashil kuthe?","Where do you think you’re going?"]],"hi":[["Ruk! Bhaag mat!","Stop! Don’t run!"],["Pakdo use!","Grab him!"],["Kahan jaayega?","Where will you go?"]]},"tackle":{"mr":[["Khaali! Haat maage!","Down! Hands behind!"],["Halu nakos!","Don’t move!"],["Jhala, saapadlas.","That’s it, got you."]],"hi":[["Neeche! Haath peeche!","Down! Hands behind!"],["Hilna mat!","Don’t move!"],["Bas, pakad liya.","That’s it, got you."]]},"cuffs":{"mr":[["Chala, chaukivar.","Come on, to the chowki."],["Tumhala atak kartoy.","You are under arrest."],["Gaadit basa.","Get in the vehicle."]],"hi":[["Chalo, thaane.","Come on, to the station."],["Tumhein giraftaar kiya jaata hai.","You are under arrest."],["Gaadi mein baitho.","Get in the vehicle."]]},"warn":{"mr":[["Thamb, naahitar goli chaalveen!","Stop, or I’ll shoot!"],["Shevatcha saangtoy!","Last warning!"],["Haat var!","Hands up!"]],"hi":[["Ruk ja, varna goli chalegi!","Stop, or I’ll shoot!"],["Aakhiri baar bol raha hoon!","Last time I’m saying it!"],["Haath upar!","Hands up!"]]}},"radio":["All units, suspect last seen near {p}.","Units near {p}, respond. Suspect on foot.","Suspect in a {v}, heading towards {p}.","{p} beat marshal, are you on it?","Accident reported at {p}. Ambulance dispatched.","Chain snatching near {p}. Suspect fled on a two-wheeler.","Nakabandi at {p}. Check every two-wheeler.","Witness reports a fight near {p}.","Camera hit at {p}. Plate flagged.","Lost visual near {p}. Widen the search."],"places":["Swargate","Shivajinagar","Deccan","FC Road","JM Road","Laxmi Road","Kasba Peth","Sadashiv Peth","Narayan Peth","Budhwar Peth","Camp","MG Road","Koregaon Park","Kalyani Nagar","Viman Nagar","Yerwada","Pune Station","Bund Garden","Kothrud","Karve Road","Erandwane","Aundh","Baner","Pashan","Sinhagad Road","Katraj","Bibwewadi","Market Yard","Hadapsar","Magarpatta","Kharadi","Wakad","Hinjewadi","Nigdi","Shaniwar Wada","Dagdusheth","Sarasbaug","Tilak Road","University Road","Senapati Bapat Road"],"veh":["black Activa","white scooter","red motorcycle","blue Pulsar","black auto","white hatchback","silver sedan","grey SUV","white Swift","yellow-top taxi"],"vd":{"tea":[["Chaha! Garam garam chaha!","Tea! Hot tea!"],["Cutting ghya, cutting!","Have a cutting!"],["Alyacha chaha, daha rupaye!","Ginger tea, ten rupees!"],["Paavsaat chaha, ya ya!","Tea in the rain, come come!"]],"vadapav":[["Vadapav! Garamagaram vadapav!","Vada pav! Piping hot!"],["Bhaji ghya, kanda bhaji!","Onion bhaji!"],["Pandhra rupayat vadapav!","Vada pav for fifteen!"],["Taje vade, aattach talle!","Fresh vadas, just fried!"]],"fruit":[["Aambe ghya, Hapus aambe!","Alphonso mangoes!"],["Keli, dazanala chaalis!","Bananas, forty a dozen!"],["Taaji phala, swastaat!","Fresh fruit, cheap!"],["Peru, chiku, daalimb!","Guava, chikoo, pomegranate!"]],"flowers":[["Gajra ghya, mogryacha gajra!","Jasmine gajra!"],["Phula, haar, devaachi phula!","Flowers, garlands!"],["Zendu, shevanti, taaji 