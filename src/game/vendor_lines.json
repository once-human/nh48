{
  "_": "Street vendors calling out their wares, by stall kind (0 tapri, 1 paan, 2 vada pav / bhaji cart, 3 fruit cart, 4 flowers and gajra, 5 sugarcane juice). Each line: [text read by the voice (Devanagari), subtitle (romanised), English]. Voice ids: vd_<kind>_<index>.",
  "0": [["चहा! गरम गरम चहा!", "Chaha! Garam garam chaha!", "Tea! Hot tea!"], ["कटिंग घ्या, कटिंग!", "Cutting ghya, cutting!", "Have a cutting chai!"], ["अमृततुल्य चहा, या या!", "Amruttulya chaha, ya ya!", "Amruttulya tea, come, come!"], ["आल्याचा चहा, फक्त दहा रुपये!", "Alyacha chaha, phakta daha rupaye!", "Ginger tea, just ten rupees!"]],
  "1": [["पान घ्या, मसाला पान!", "Paan ghya, masala paan!", "Get your paan, masala paan!"], ["मीठा पान, कलकत्ता पान!", "Meetha paan, Kalkatta paan!", "Sweet paan, Calcutta paan!"], ["फायर पान, एकदा खाऊन बघा!", "Fire paan, ekda khaun bagha!", "Fire paan, try it once!"]],
  "2": [["वडापाव! गरमागरम वडापाव!", "Vadapav! Garamagaram vadapav!", "Vada pav! Piping hot vada pav!"], ["भजी घ्या, कांदा भजी!", "Bhaji ghya, kanda bhaji!", "Get your bhaji, onion bhaji!"], ["पंधरा रुपयात वडापाव!", "Pandhra rupayat vadapav!", "Vada pav for fifteen rupees!"], ["ताजे वडे, आत्ताच तळले!", "Taje vade, attach talle!", "Fresh vadas, just fried!"]],
  "3": [["आंबे घ्या, हापूस आंबे!", "Aambe ghya, Hapus aambe!", "Mangoes! Alphonso mangoes!"], ["केळी, डझनाला चाळीस!", "Keli, dazanala chalis!", "Bananas, forty a dozen!"], ["ताजी फळं, स्वस्तात!", "Taji phala, swastat!", "Fresh fruit, cheap!"], ["पेरू, चिकू, डाळिंब, घ्या!", "Peru, chiku, dalimb, ghya!", "Guava, chikoo, pomegranate, buy!"]],
  "4": [["गजरा घ्या, मोगऱ्याचा गजरा!", "Gajra ghya, mogryacha gajra!", "Get a gajra, jasmine gajra!"], ["फुलं, हार, देवाची फुलं!", "Phula, haar, devachi phula!", "Flowers, garlands, flowers for the gods!"], ["झेंडू, शेवंती, ताजी फुलं!", "Zendu, shevanti, taji phula!", "Marigold, chrysanthemum, fresh flowers!"]],
  "5": [["उसाचा रस! थंडगार!", "Usacha ras! Thandgaar!", "Sugarcane juice! Ice cold!"], ["रसवंती, या, ग्लास वीस रुपये!", "Rasvanti, ya, glass vees rupaye!", "Juice here, come, twenty a glass!"], ["लिंबू आलं घालून, उसाचा रस!", "Limbu aala ghalun, usacha ras!", "With lemon and ginger, sugarcane juice!"]]
}
